# Copia este archivo como .env y completa tus valores
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=tu_contraseña
PGDATABASE=soqual
PGPORT=5432

PORT=3000
NODE_ENV=development
# Orígenes extra permitidos para la API (separados por coma)
ALLOWED_ORIGINS=http://localhost:5501,http://127.0.0.1:5501

# Asistente virtual de la página de contacto (Google AI Studio). Sin clave, el chat avisa que no está disponible.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
